# ============================================================
# AGHAT SETHU — Backend Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# PostgreSQL connection (psycopg 3 driver — already installed as psycopg[binary])
# Create the database first: CREATE DATABASE aghat_sethu;
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/aghat_sethu

# JWT Authentication
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=CHANGE_ME_GENERATE_A_REAL_SECRET_BEFORE_DEPLOYING
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS — frontend origin (Vite dev server)
CORS_ORIGINS=http://localhost:5173

# Application environment
APP_ENV=development

# WebRTC camera streams (MediaMTX on this machine; see ../media-server/README-STREAMING.md)
WEBRTC_ENABLED=true
MEDIAMTX_WHEP_URL=http://127.0.0.1:8889
MEDIAMTX_READ_USER=website
# must equal MTX_AUTHINTERNALUSERS_1_PASS in ../media-server/.env
MEDIAMTX_READ_PASS=CHANGE_ME_READER_PASSWORD
WEBRTC_STREAMS=J01:cam1,J02:cam2,J03:cam3
# Browsers' ICE servers (JSON). Add a TURN entry for viewers on the public internet.
WEBRTC_ICE_SERVERS=[{"urls": ["stun:stun.l.google.com:19302"]}]
