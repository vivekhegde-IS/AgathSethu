# ============================================================
# AGHAT SETHU — Backend Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# PostgreSQL connection (psycopg 3 driver — already installed as psycopg[binary])
# Create the database first: CREATE DATABASE aghat_sethu;
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/aghat_sethu

# JWT Authentication
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=CHANGE_ME_GENERATE_A_REAL_SECRET_BEFORE_DEPLOYING
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS — frontend origin (Vite dev server)
CORS_ORIGINS=http://localhost:5173

# Application environment
APP_ENV=development
