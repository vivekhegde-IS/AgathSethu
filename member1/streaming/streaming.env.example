# WebRTC camera streaming (member1/streaming/h264_streamer.py) - set these in
# the environment that runs full_run.py on the CARLA machine.
#
# PowerShell:
#   $env:STREAM_RTSP_BASE = "rtsp://100.118.103.8:8554"
#   $env:STREAM_PUBLISH_USER = "carla"
#   $env:STREAM_PUBLISH_PASS = "<MTX_AUTHINTERNALUSERS_0_PASS from member3/media-server/.env>"
#   python full_run.py

STREAM_ENABLED=1
# MediaMTX on the website machine (Tailscale address)
STREAM_RTSP_BASE=rtsp://100.118.103.8:8554
STREAM_PUBLISH_USER=carla
STREAM_PUBLISH_PASS=CHANGE_ME_PUBLISHER_PASSWORD
STREAM_CAMERAS=1:cam1,2:cam2,3:cam3
# Output rate: keep ABOVE the 20 Hz CARLA camera rate (see h264_streamer.py)
STREAM_FPS=30
# 0 = native 1280x720
STREAM_WIDTH=0
STREAM_HEIGHT=0
STREAM_BITRATE_KBPS=3000
# auto = NVENC when a working NVIDIA GPU is found, else x264
STREAM_ENCODER=auto
STREAM_X264_PRESET=veryfast
# path to ffmpeg if it is not on PATH
STREAM_FFMPEG=ffmpeg
# 1 = burn sim time / frame / wall-clock ms into the video (latency measurement)
STREAM_DEBUG_OVERLAY=0
