# ============================================================
# AGHAT SETHU — Frontend Environment Configuration
# Copy this file to .env and fill in the actual values.
# NEVER commit .env to version control.
# ============================================================

# ── Backend API ──────────────────────────────────────────────────────────────────
# Base URL for FastAPI backend — do NOT include a trailing slash
VITE_API_BASE_URL=http://localhost:8000/api
VITE_WS_URL=ws://localhost:8000/ws

# ── Authentication Mode ───────────────────────────────────────────────────────────
# VITE_ENABLE_REAL_AUTH controls whether authentication uses FastAPI + PostgreSQL.
# This is SEPARATE from VITE_ENABLE_MOCK_DATA.
#
# VITE_ENABLE_REAL_AUTH=false → mock authentication (existing demo behavior)
# VITE_ENABLE_REAL_AUTH=true  → real FastAPI + PostgreSQL authentication
#
# Allowed combinations:
#   VITE_ENABLE_MOCK_DATA=true  + VITE_ENABLE_REAL_AUTH=false → full mock demo
#   VITE_ENABLE_MOCK_DATA=true  + VITE_ENABLE_REAL_AUTH=true  → real auth + mock sensors
#   VITE_ENABLE_MOCK_DATA=false + VITE_ENABLE_REAL_AUTH=true  → full real mode
VITE_ENABLE_REAL_AUTH=false

# ── Sensor Data Mode ──────────────────────────────────────────────────────────────
# Controls Member 1 (CARLA), Member 2 (ANPR), Member 3 (RFID/FASTag) adapters.
# true  → use mock sensor data (adapters use MockMember services)
# false → use real member service endpoints below
VITE_ENABLE_MOCK_DATA=true

# ── Application Settings ──────────────────────────────────────────────────────────
VITE_APP_NAME=AGHAT SETHU
VITE_APP_ENVIRONMENT=development

# ── Authentication Token Storage ──────────────────────────────────────────────────
# Key used to store JWT in localStorage (frontend only)
VITE_JWT_STORAGE_KEY=aghat_sethu_jwt

# ── Member Services (disable for production, enable mock adapters) ────────────────
# These are ONLY used when VITE_ENABLE_MOCK_DATA=false
VITE_MEMBER_1_ENABLED=true
VITE_MEMBER_2_ENABLED=false
VITE_MEMBER_3_ENABLED=false
VITE_MEMBER_1_BASE_URL=http://localhost:9001
VITE_MEMBER_2_BASE_URL=http://localhost:9002
VITE_MEMBER_3_BASE_URL=http://localhost:9003

# ── CARLA Integration ─────────────────────────────────────────────────────────────
VITE_CARLA_API_URL=http://localhost:9000

# ─────────────────────────────────────────────────────────────────────────────────
# SECURITY NOTES:
# - DATABASE_URL, JWT_SECRET are BACKEND secrets — see backend/.env.example
# - Never prefix backend secrets with VITE_ (they would be exposed to the browser)
# - VITE_ variables are embedded in the browser bundle — treat as public
# ─────────────────────────────────────────────────────────────────────────────────
