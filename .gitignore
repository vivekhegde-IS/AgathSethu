*.py[cod]
*$py.class
*.pyo
.venv/
venv/
ENV/
env/
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Databases ---
*.db
*.sqlite3
*.sqlite

# --- Environment / Secrets (NEVER commit) ---
.env
.env.local
.env.*.local
backend/.env
member3/backend/.env
member3/frontend/.env

# --- Frontend / Node ---
node_modules/
member3/frontend/node_modules/
member3/frontend/dist/
member3/frontend/.vite/
dist/
.vite/
yarn.lock
pnpm-lock.yaml

# --- Large Media Files (>50MB — use external storage or Git LFS) ---
*.mp4
*.mkv
*.avi
*.mov
*.wmv
*.flv
*.webm
*.pt
*.pth
*.onnx
*.bin

# --- IDE & Editor ---
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*.sublime-project
*.sublime-workspace

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Testing & Coverage ---
coverage/
.nyc_output/
.pytest_cache/
htmlcov/
.coverage

# --- Alembic (keep migrations, ignore generated cache) ---
member3/backend/alembic/__pycache__/

# --- Misc ---
*.patch
*.cache
.cache/

# --- Citizen fines (plaintext test passwords + violation snapshots/clips) ---
member3/backend/data/citizen_credentials.csv
member3/backend/static/violations/

# --- Media server secrets ---
member3/media-server/.env
member3/media-server/mediamtx.exe

# real-world datasets (raw downloads, not in git)
realdata/raw/

# --- Generated at runtime / build ---
member3/backend/runtime/
runtime/
member3/backend/models/openvino_cache/
member3/HelmetAI/static/uploads/
*.tsbuildinfo
*.env.bak
.freebuff/
