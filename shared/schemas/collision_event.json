{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "COLLISION_PAIR_IDENTIFIED",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "timestamp_sim",
    "source",
    "junction_id",
    "vehicle_ids",
    "confidence"
  ],
  "properties": {
    "event_id": { "type": "string" },
    "event_type": { "type": "string", "enum": ["COLLISION_PAIR_IDENTIFIED"] },
    "timestamp_sim": { "type": "number" },
    "source": { "type": "string" },
    "junction_id": { "type": "string" },
    "vehicle_ids": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 2
    },
    "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "impact_severity": { "type": "string" }
  }
}
