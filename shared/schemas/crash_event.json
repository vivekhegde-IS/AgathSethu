{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CRASH_DETECTED",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "timestamp_sim",
    "source",
    "junction_id",
    "vehicle_id",
    "confidence"
  ],
  "properties": {
    "event_id": { "type": "string" },
    "event_type": { "type": "string", "enum": ["CRASH_DETECTED"] },
    "timestamp_sim": { "type": "number" },
    "source": { "type": "string" },
    "junction_id": { "type": "string" },
    "vehicle_id": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "telemetry_summary": { "type": "object" }
  }
}
