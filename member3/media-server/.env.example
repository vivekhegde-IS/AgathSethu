# MediaMTX secrets - copy to .env (never commit .env).
# Generate each with:  python -c "import secrets; print(secrets.token_urlsafe(24))"

# Publisher (CARLA machine): same value as STREAM_PUBLISH_PASS in member1's environment
MTX_AUTHINTERNALUSERS_0_PASS=CHANGE_ME_PUBLISHER_PASSWORD
# Reader (website backend): same value as MEDIAMTX_READ_PASS in member3/backend/.env
MTX_AUTHINTERNALUSERS_1_PASS=CHANGE_ME_READER_PASSWORD

# Addresses of THIS machine that viewers use (Tailscale, LAN), comma separated.
MTX_WEBRTCADDITIONALHOSTS=100.118.103.8
