# ============================================================
# AGHAT SETHU — Backend Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# PostgreSQL connection (psycopg 3 driver — already installed as psycopg[binary])
# Create the database first: CREATE DATABASE aghat_sethu;
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/aghat_sethu

# JWT Authentication
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=CHANGE_ME_GENERATE_A_REAL_SECRET_BEFORE_DEPLOYING
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS — frontend origin (Vite dev server)
CORS_ORIGINS=http://localhost:5173

# Application environment
APP_ENV=development

# WebRTC camera streams (MediaMTX on this machine; see ../media-server/README-STREAMING.md)
WEBRTC_ENABLED=true
MEDIAMTX_WHEP_URL=http://127.0.0.1:8889
MEDIAMTX_READ_USER=website
# must equal MTX_AUTHINTERNALUSERS_1_PASS in ../media-server/.env
MEDIAMTX_READ_PASS=CHANGE_ME_READER_PASSWORD
WEBRTC_STREAMS=J01:cam1,J02:cam2,J03:cam3
# Browsers' ICE servers (JSON). Add a TURN entry for viewers on the public internet.
WEBRTC_ICE_SERVERS=[{"urls": ["stun:stun.l.google.com:19302"]}]

# Public website address (links in emails)
SITE_URL=http://localhost:5173

# Welcome email on a user's first login (Gmail: an App Password, not the
# account password). Leave SMTP_PASSWORD empty to send no emails.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_NAME=AGHAT SETHU

# ── Sign in with Google (vehicle owners only; authority never) ─────────────────
# Leave all three empty to hide the Google button (password login unchanged).
# See member3/README.md "Sign in with Google" for the Cloud Console setup.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
# Optional demo pre-linking (matched once on a verified email, then by `sub`):
# GOOGLE_OWNER_LINKS=arjun.rao=you@gmail.com,priya.patel=other@gmail.com
GOOGLE_OWNER_LINKS=

# ── Crash text messages ────────────────────────────────────────────────────────
# Default: ConsoleSmsProvider (logged + stored, nothing sent). Twilio is used only
# when all three are set; placeholder numbers (+9100000...) are never sent to.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Alerts for the same car (or its partner) within this window = one incident,
# one text message.
CRASH_NOTIFY_COOLDOWN_S=120
