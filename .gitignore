# ============================================================
# AGHAT SETHU — Repository .gitignore
# ============================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.pyo
.venv/
venv/
ENV/
env/
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Databases ---
*.db
*.sqlite3
*.sqlite

# --- Environment / Secrets (NEVER commit) ---
.env
.env.local
.env.*.local
backend/.env
member3/backend/.env
member3/frontend/.env

# --- Frontend / Node ---
node_modules/
member3/frontend/node_modules/
member3/frontend/dist/
member3/frontend/.vite/
dist/
.vite/
package-lock.json
yarn.lock
pnpm-lock.yaml

# --- Large Media Files (>50MB — use external storage or Git LFS) ---
*.mp4
*.mkv
*.avi
*.mov
*.wmv
*.flv
*.webm
*.pt
*.pth
*.onnx
*.bin

# --- IDE & Editor ---
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*.sublime-project
*.sublime-workspace

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Testing & Coverage ---
coverage/
.nyc_output/
.pytest_cache/
htmlcov/
.coverage

# --- Alembic (keep migrations, ignore generated cache) ---
member3/backend/alembic/__pycache__/

# --- Misc ---
*.patch
*.cache
.cache/
